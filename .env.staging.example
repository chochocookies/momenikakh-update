# Application Configuration
APP_NAME="Momenikah (Staging)"
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.momenikah.test

# Application Locale
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance Mode
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP CLI Server
PHP_CLI_SERVER_WORKERS=4

# Encryption
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Staging)
# Required: Replace with actual staging database credentials
DB_CONNECTION=mysql
DB_HOST=staging-db.momenikah.internal
DB_PORT=3306
DB_DATABASE=momenikah_staging
DB_USERNAME=momenikah_staging
DB_PASSWORD=your_strong_database_password

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.momenikah.test

# Broadcast Configuration
BROADCAST_CONNECTION=log

# Queue Configuration
QUEUE_CONNECTION=redis

# Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX=momenikah_staging_

# Redis Configuration
# Required: Replace with actual staging Redis credentials
REDIS_CLIENT=phpredis
REDIS_HOST=staging-redis.momenikah.internal
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379

# Filesystem Configuration
FILESYSTEM_DISK=s3
PUBLIC_DISK=s3

# S3 Storage Configuration (Staging)
# Required: Replace with actual AWS credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=momenikah-staging
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=https://momenikah-staging.s3.ap-southeast-1.amazonaws.com

# Mail Configuration
# Required: Replace with actual SMTP credentials
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM_ADDRESS="no-reply@momenikah.test"
MAIL_FROM_NAME="${APP_NAME}"

# Sentry Configuration
# Required: Replace with actual Sentry DSN
SENTRY_LARAVEL_DSN=your_sentry_dsn_here
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_ENVIRONMENT=staging

# Surface Domains (Staging)
MARKETING_DOMAIN=staging.momenikah.test
APP_SUBDOMAIN=staging-app.momenikah.test
PUBLIC_DOMAIN=staging-undangan.momenikah.test

# Application URL (for storage links)
APP_STORAGE_URL=https://staging.momenikah.test/storage

# Horizon (Queue Supervisor)
# Required: Set a secure password for Horizon dashboard
HORIZON_PASSWORD=your_horizon_password_here

# Monitoring
HEALTH_CHECK_URL=https://staging.momenikah.test/health

# Server Configuration (for deployment scripts)
STAGING_SSH_USER=deploy
STAGING_SSH_HOST=staging.momenikah.test
STAGING_SSH_PORT=22
STAGING_SSH_KEY=~/.ssh/id_rsa

# Staging Database (for deployment scripts)
STAGING_DB_HOST=staging-db.momenikah.internal
STAGING_DB_PORT=3306
STAGING_DB_DATABASE=momenikah_staging
STAGING_DB_USERNAME=momenikah_staging

# Staging Redis (for deployment scripts)
STAGING_REDIS_HOST=staging-redis.momenikah.internal
STAGING_REDIS_PORT=6379

# Staging Storage (for deployment scripts)
STAGING_STORAGE_DISK=s3
STAGING_STORAGE_BUCKET=momenikah-staging
STAGING_STORAGE_REGION=ap-southeast-1

# AWS Credentials (for deployment scripts)
STAGING_AWS_ACCESS_KEY_ID=your_aws_access_key_id
STAGING_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
STAGING_AWS_DEFAULT_REGION=ap-southeast-1
STAGING_AWS_BUCKET=momenikah-staging
STAGING_AWS_URL=https://momenikah-staging.s3.ap-southeast-1.amazonaws.com

# Telemetry and Debugging
TELESCOPE_ENABLED=true
HORIZON_ENABLED=true
EXPERIMENTAL_FEATURES=true
DEVELOPER_TOOLS=true

# Secure Credential Storage
# DO NOT commit .env.staging to version control
# Use environment variables or a secrets manager in production
# For local development, keep .env.staging in a secure location
# Recommended: Use AWS Secrets Manager, HashiCorp Vault, or similar