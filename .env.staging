# Application Configuration
APP_NAME="Momenikah (Staging)"
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.momenikah.test

# Application Locale
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance Mode
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP CLI Server
PHP_CLI_SERVER_WORKERS=4

# Encryption
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Staging)
DB_CONNECTION=mysql
DB_HOST=staging-db.momenikah.internal
DB_PORT=3306
DB_DATABASE=momenikah_staging
DB_USERNAME=momenikah_staging
DB_PASSWORD=${DB_PASSWORD}

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.momenikah.test

# Broadcast Configuration
BROADCAST_CONNECTION=log

# Queue Configuration
QUEUE_CONNECTION=redis

# Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX=momenikah_staging_

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=staging-redis.momenikah.internal
REDIS_PASSWORD=null
REDIS_PORT=6379

# Filesystem Configuration
FILESYSTEM_DISK=s3
PUBLIC_DISK=s3

# S3 Storage Configuration (Staging)
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=momenikah-staging
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=https://momenikah-staging.s3.ap-southeast-1.amazonaws.com

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=${MAIL_USERNAME}
MAIL_PASSWORD=${MAIL_PASSWORD}
MAIL_FROM_ADDRESS="no-reply@momenikah.test"
MAIL_FROM_NAME="${APP_NAME}"

# Sentry Configuration
SENTRY_LARAVEL_DSN=${SENTRY_LARAVEL_DSN}
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_ENVIRONMENT=staging

# Surface Domains (Staging)
MARKETING_DOMAIN=staging.momenikah.test
APP_SUBDOMAIN=staging-app.momenikah.test
PUBLIC_DOMAIN=staging-undangan.momenikah.test

# Application URL (for storage links)
APP_STORAGE_URL=https://staging.momenikah.test/storage

# Horizon (Queue Supervisor)
HORIZON_PASSWORD=${HORIZON_PASSWORD}

# Monitoring
HEALTH_CHECK_URL=https://staging.momenikah.test/health