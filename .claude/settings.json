{
  "permissions": {
    "allow": [
      "Bash(node .claude/scripts/task.mjs:*)",
      "Bash(composer check)", "Bash(composer test)", "Bash(composer lint)",
      "Bash(./vendor/bin/pest:*)", "Bash(./vendor/bin/pint:*)", "Bash(./vendor/bin/phpstan:*)",
      "Bash(php artisan test:*)", "Bash(php artisan route:list:*)", "Bash(php artisan template:lint:*)",
      "Bash(php -l:*)", "Bash(npm run build)", "Bash(npm run lint:*)",
      "Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(./storage/logs/**)", "Read(./**/*.sql)", "Read(./**/*.sqlite)",
      "Bash(php artisan migrate:fresh:*)", "Bash(php artisan db:wipe:*)", "Bash(php artisan migrate:reset:*)",
      "Bash(rm -rf:*)", "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)"
    ]
  }
}
