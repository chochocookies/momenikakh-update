APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=momenikah
DB_USERNAME=momenikah
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backup Configuration
# The filesystem disk where database backups will be stored (local, s3, etc.)
BACKUP_DISK=local

# Retention policy (days)
# Minimum days to keep backups (default: 7)
BACKUP_MIN_RETENTION_DAYS=7

# Maximum days to keep backups (default: 30)
BACKUP_MAX_RETENTION_DAYS=30

# Lock timeout for backup concurrency control (seconds)
BACKUP_LOCK_TIMEOUT=3600

VITE_APP_NAME="${APP_NAME}"

# Surface domains (defaults shown; override per environment)
MARKETING_DOMAIN=momenikah.test
APP_SUBDOMAIN=app.momenikah.test
PUBLIC_DOMAIN=undangan.momenikah.test

# --- Guests (GST) ---
PUBLIC_BASE_URL=https://undangan.momenikah.test

# --- Media (MED-01) ---
# Local MinIO (docker compose -f docker/docker-compose.media.yml up -d). Leave MEDIA_DRIVER unset to store files in storage/app/public/media.
MEDIA_DRIVER=s3
MEDIA_BUCKET=momenikah-media
MEDIA_ENDPOINT=http://localhost:9000
MEDIA_PATH_STYLE=true
MEDIA_REGION=us-east-1
MEDIA_ACCESS_KEY=momenikah
MEDIA_SECRET_KEY=change-me-local-only
MEDIA_CDN_URL=http://localhost:9000/momenikah-media
# Production (Cloudflare R2 + custom domain on the bucket; decision DEC-04):
#   MEDIA_REGION=auto
#   MEDIA_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   MEDIA_PATH_STYLE=false
#   MEDIA_CDN_URL=https://media.momenikah.online

TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
